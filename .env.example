# Postgres connection string (Neon / Render / local). Required.
# Neon example: postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Session cookie signing secret. Required. Generate one: openssl rand -hex 32
SESSION_SECRET=

# First-admin bootstrap, read by `npm run seed:admin`.
# The password is forcibly rotated at the admin's first login, so this value
# does not remain live. Never commit a real .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional. Defaults to 10000.
PORT=10000

# Feature flag: when 'true', unauthenticated visitors can view the basic
# winner/alliance map and shareable links / iframe embeds work without login.
# Analysis, API and exports always stay behind login + Pro. Default off.
PUBLIC_ACCESS_ENABLED=false

# Razorpay billing (optional). When these are unset the upgrade flow is
# disabled gracefully and admins grant Pro manually. Use test keys in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
